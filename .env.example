# WhatsApp (número con código de país, sin +)
VITE_WHATSAPP_NUMBER=59172601952

# Información de contacto
VITE_CONTACT_EMAIL=rmceventos@gmail.com
VITE_CONTACT_PHONE=72601952
VITE_CONTACT_CITY=Santa Cruz, Bolivia

# ── Solo para Cloud Functions (NO exponer al cliente) ──

# Resend (email transaccional) — se obtiene de https://resend.com
RESEND_API_KEY=

# reCAPTCHA secret key (server-side)
RECAPTCHA_SECRET_KEY=

# Email de notificación (donde llegan los mensajes de contacto)
