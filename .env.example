# ══════════════════════════════════════════════════════
# RMC EVENTOS — Variables de Entorno
# ══════════════════════════════════════════════════════
# Copiar este archivo como .env.local en landing/ y admin/
# Los datos de contacto (teléfono, email, redes) se gestionan
# desde el panel admin → Configuración → se guardan en Firestore.

# Firebase SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 (opcional, para proteger formularios)
VITE_RECAPTCHA_SITE_KEY=

# Google Analytics 4 (opcional)
VITE_GA_MEASUREMENT_ID=

# Google Tag Manager (opcional)
VITE_GTM_ID=
