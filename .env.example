VITE_FIREBASE_STORAGE_BUCKET=rmc-eventos-bo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 (se obtiene de https://www.google.com/recaptcha/admin)
