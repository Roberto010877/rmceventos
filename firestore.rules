rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones auxiliares ──

    function estaAutenticado() {
      return request.auth != null;
    }

    // Obtener el rol del usuario desde la colección 'usuarios'
    // (mientras no hay Cloud Functions para Custom Claims)
    function getRol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function esEditor() {
      return estaAutenticado() && getRol() in ['editor', 'admin', 'superadmin'];
    }

    function esAdmin() {
      return estaAutenticado() && getRol() in ['admin', 'superadmin'];
    }

    function esSuperadmin() {
      return estaAutenticado() && getRol() == 'superadmin';
    }

    // ── Regla base: por defecto todo está denegado ──
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Colección: configuracion ──
    // Lectura pública (la landing necesita leer teléfono, email, redes)
    // Escritura solo admin+
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ── Colección: fotos ──
    // Lectura pública solo si están listas para mostrar
    // Escritura: editor+ puede crear/editar, admin+ puede borrar
    match /fotos/{fotoId} {
      allow read: if resource.data.estadoProcesamiento == 'listo'
                  || (estaAutenticado() && esEditor());
      allow create: if esEditor();
      allow update: if esEditor();
      allow delete: if esAdmin();
    }

    // ── Colección: servicios ──
    // Lectura pública, escritura solo admin+
    match /servicios/{servicioId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ── Colección: testimonios ──
    // Lectura pública solo si aprobados; lectura completa para admin+
    // Creación pública (formulario), moderación solo admin+
    match /testimonios/{testimonioId} {
      allow read: if resource.data.aprobado == true
                  || (estaAutenticado() && esAdmin());
      allow create: if true;  // Público: enviar testimonio
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    // ── Colección: eventos ──
    // Lectura: editor+, Escritura: admin+
    match /eventos/{eventoId} {
      allow read: if esEditor();
      allow create, update: if esAdmin();
      allow delete: if esAdmin();
    }

    // ── Colección: contactos ──
    // La creación pública debe pasar por Cloud Functions/API. Lectura y gestión: admin+
    match /contactos/{contactoId} {
      allow create: if false;
      allow read, update: if esAdmin();
      allow delete: if esAdmin();
    }

    // ── Colección: usuarios ──
    // Solo superadmin puede leer y escribir
    // Excepción: un usuario autenticado puede leer su propio documento
    // Bootstrap: el primer superadmin puede crear su propio doc si no existe
    match /usuarios/{userId} {
      allow read: if estaAutenticado() && (request.auth.uid == userId || esSuperadmin());
      allow create: if esSuperadmin()
                    || (estaAutenticado()
                        && request.auth.uid == userId
                        && request.auth.token.email == 'melgar.robertocarlos@gmail.com'
                        && !exists(/databases/$(database)/documents/usuarios/$(userId)));
      allow update, delete: if esSuperadmin();
    }

    // ── Colección: auditoria ──
    // Solo lectura para superadmin, escritura desde admin+ (para logging)
    match /auditoria/{logId} {
      allow read: if esSuperadmin();
      allow create: if esEditor();
      allow update, delete: if false;
    }
  }
}
